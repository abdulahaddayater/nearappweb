# --- NEAR (testnet-first) ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_EXPLORER=https://testnet.nearblocks.io
USDC_CONTRACT=usdc.fakes.testnet

# --- Relayer (pays gas for every payment; server-side only, never expose) ---
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=          # ed25519:...

# --- NEAR Auth (Google / Apple / email / passkey sign-in, no seed phrase) ---
NEAR_AUTH_URL=
NEAR_AUTH_CLIENT_ID=

# --- Request store (optional; in-memory if unset — fine for local dev, not for multi-instance Vercel) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

REQUEST_TTL_MS=300000
MAX_AMOUNT=1000
# Force simulation even when relayer is configured
TAPPAY_DEMO_MODE=
